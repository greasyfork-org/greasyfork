<h3><%= t('scripts.derivatives_heading') %></h3>

<p><%= t('scripts.derivatives_intro') %></p>

<h4><%= t('scripts.derivatives_exact_copies_heading') %></h4>

<% identical_svs = @script.script_versions_with_identical_code.group_by(&:script_id).values %>

<% if identical_svs.any? %>
  <p><%= t('scripts.derivatives_exact_copies_list_intro') %></p>
  <ul>
    <% identical_svs.each do |svs| %>
      <li>
        <% script = svs.first.script %>
        <%= t('scripts.derivatives_exact_copies_item_html', script_link: render_script(script), author_links: script.users.map { |u| link_to u.name, user_path(u) }.to_sentence.html_safe, version_list: svs.map(&:version).uniq.join(', ')) %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t('scripts.derivatives_exact_copes_none', site_name: site_name) %></p>
<% end %>

<h4><%= t('scripts.derivatives_similar_heading') %></h4>

<% if @token_shingle_similarities.any? %>
  <p><%= t('scripts.derivatives_similar_info', threshold: number_to_percentage(TokenShingleSimilarityScorer::MIN_DISPLAYED_SIMILARITY * 100, strip_insignificant_zeros: true)) %></p>
  <ul>
    <% @token_shingle_similarities.each do |other_script, score| %>
      <li title="<%= score %>">
        <%= it('scripts.derivatives_similar_item', score: token_shingle_similarity_string(score), diff_link: derivatives_script_path(@script, compare: script_url(other_script), anchor: 'script-comparison'), script: render_script(other_script)) %>
        <%= t('scripts.deleted_marker') if other_script.deleted? %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p><%= t('scripts.derivatives_similar_none', threshold: number_to_percentage(TokenShingleSimilarityScorer::MIN_DISPLAYED_SIMILARITY * 100, strip_insignificant_zeros: true)) %></p>
<% end %>
