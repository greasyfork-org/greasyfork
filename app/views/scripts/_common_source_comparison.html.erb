<div class="common-source-comparison">
  <p>
    <%= t('scripts.common_source_summary', count: common_source_locations.fetch(:similarity_count), sample_count: common_source_locations.fetch(:maximum_similarity_count)) %>
  </p>
  <% common_source_locations.fetch(:matches).each_with_index do |match, index| %>
    <section class="common-source-match">
      <h4><%= t('scripts.common_source_snippet', index: index + 1) %></h4>
      <div class="common-source-comparison-columns">
        <div>
          <h5>
            <%= t('scripts.by_author', script: render_script(script), authors: script.users.map { |user| link_to(user.name, user) }.to_sentence.html_safe) %>
          </h5>
          <% match.fetch(:script).each do |section| %>
            <pre><code><%= source_with_highlights(this_code, section) %></code></pre>
          <% end %>
        </div>
        <div>
          <h5>
            <%= t('scripts.by_author', script: render_script(other_script), authors: other_script.users.map { |user| link_to(user.name, user) }.to_sentence.html_safe) %>
          </h5>
          <% match.fetch(:other_script).each do |section| %>
            <pre><code><%= source_with_highlights(other_code, section) %></code></pre>
          <% end %>
        </div>
      </div>
      <% truncation_note = common_source_truncation_note(match) %>
      <% if truncation_note %>
        <p class="common-source-truncated"><em><%= truncation_note %></em></p>
      <% end %>
    </section>
  <% end %>
</div>
