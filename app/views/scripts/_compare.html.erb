<%# locals: ()  %>

<section id="script-comparison" class="multiform-page">
  <h3><%= t('scripts.admin.compare_title') %></h3>

  <%= form_with(url: derivatives_script_path(@script, anchor: 'comparison-result'), method: :GET, html: { class: 'diff_options' }) do |f| %>
    <div class="form-control">
      <%= f.label :compare, t('scripts.admin.compare_to', site_name: site_name) %>
      <%= f.url_field :compare, required: true, value: params[:compare], placeholder: 'https://greasyfork.org/…' %>
    </div>
    <% selected_view = @compare_view || 'diff' %>
    <div class="form-control compare-view-options">
      <span class="compare-view-title"><%= t('scripts.diff_view_title') %></span>
      <% %w[diff clean snippets].each do |view| %>
        <div class="compare-view-option">
          <%= f.label "view_#{view}", class: 'radio-label' do %>
            <%= f.radio_button :view, view, checked: selected_view == view %>
            <%= t("scripts.diff_view_#{view}") %>
          <% end %>
        </div>
      <% end %>
    </div>
    <%= render partial: 'diff_options', locals: { context: @context, ignore_whitespace: false } %>
    <%= f.submit t('scripts.admin.compare_button') %>
  <% end %>

  <% if @diff_error %>
    <p class="notice"><%= @diff_error %></p>
  <% elsif @diff || @common_source_locations || @this_code %>
    <p id="comparison-result">
      <%= t('scripts.by_author', script: render_script(@other_script), authors: @other_script.users.map { |user| link_to(user.name, user) }.to_sentence.html_safe) %>
    </p>

    <% if @compare_view == 'snippets' %>
      <% if @common_source_locations&.fetch(:similarity_count, 0)&.positive? %>
        <%= render partial: 'common_source_comparison', locals: {
          common_source_locations: @common_source_locations,
          other_script: @other_script,
          other_code: @other_code,
          script: @script,
          this_code: @this_code,
        } %>
      <% else %>
        <p class="notice"><%= t('scripts.common_snippets_none') %></p>
      <% end %>
    <% elsif @diff.diff.empty? %>
      <p class="notice"><%= t('scripts.diff_no_change') %></p>
    <% else %>
      <%= @diff.to_s(:html).html_safe %>
    <% end %>
  <% end %>
</section>
