<%# locals: (attachable:)  %>

<% attachments = attachable.attachments.includes(blob: { variant_records: { image_attachment: :blob }}).load %>
<% if attachments.any? %>
  <div class="user-screenshots">
    <% attachments.each do |attachment| %>
      <%= render partial: 'screenshots/attachment', locals: { attachment: } %>
    <% end %>
  </div>
<% end %>
